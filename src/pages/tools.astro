          <div class="dtop" data-pane="5" data-title="~/tools/efiboot-manager" data-sub="EFIBoot Manager" hidden style="gap: max(16px, 2cqw);">
            <div class="dcell">
              <img class="dshot" src="/media/EFIBootGUIMain.webp" alt="EFIBoot Manager screenshot" loading="lazy" style="border: 1px solid var(--line);">
