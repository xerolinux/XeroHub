---
import Shell from '../layouts/Shell.astro';
---

<Shell title="Tools" description="XeroLinux in-house tools: xPackageManager, Customization Hub, iBackup/Restore and more." current="/tools/" label="Xero Tools" winTitle="~/tools/xpackagemanager" winSub="xPackageManager">
      <div class="pane" data-tabs style="padding: max(14px, calc(2.4*var(--qh))) max(18px, 2cqw); gap: max(12px, calc(1.8*var(--qh))); font-size: max(13px, calc(1.5*var(--qh))); color: var(--text2);">
          <div class="dtop" data-pane="0" data-title="~/tools/xpackagemanager" data-sub="xPackageManager" style="gap: max(16px, 2cqw);">
            <div class="dcell">
              <img class="dshot" src="/media/xpm-demo.webp" alt="xPackageManager screenshot" loading="lazy" style="border: 1px solid var(--line);">
            </div>
            <div style="min-width: 0; display: flex; flex-direction: column; gap: max(10px, calc(1.4*var(--qh)));">
              <div class="kick" style="color: var(--accentL);">Flagship · System</div>
              <h3 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2.1em; line-height: 1; color: var(--text);">xPackageManager</h3>
              <p style="margin: 0;">pacman and Flatpak in one native window, written in Rust.</p>
              <ul class="feats" style="font-size: .94em;">
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Install, update and remove from one place</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Built-in repair tools</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>One-click pacman rollback</span></li>
              </ul>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="font-size: .8em;">On XeroLinux</div>
                <div class="cmd one" style="--n: 24;"><pre style="background: var(--glass); color: var(--text); border: 1px solid var(--line);">sudo pacman -Syy xpm-gui</pre><button type="button" data-copy="sudo pacman -Syy xpm-gui" aria-label="Copy command" title="Copy" style="border: 1px solid var(--line); background: transparent; color: var(--text);"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>
              </div>
              <div data-btnrow style="display: flex; flex-wrap: wrap; gap: 10px;"><a href="https://github.com/xerolinux/xPackageManager" target="_blank" rel="noopener noreferrer" style="min-height: 44px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 0 16px; border-radius: 10px; text-decoration: none; border: 1px solid var(--line); color: var(--text);"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex: none;"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>GitHub</a></div>
            </div>
          </div>
          <div class="dtop" data-pane="1" data-title="~/tools/customization-hub" data-sub="Customization Hub" hidden style="gap: max(16px, 2cqw);">
            <div class="dcell">
              <img class="dshot" src="/media/xero-tool.webp" alt="Customization Hub screenshot" loading="lazy" style="border: 1px solid var(--line);">
            </div>
            <div style="min-width: 0; display: flex; flex-direction: column; gap: max(10px, calc(1.4*var(--qh)));">
              <div class="kick" style="color: var(--accentL);">Look &amp; Feel</div>
              <h3 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2.1em; line-height: 1; color: var(--text);">Customization Hub</h3>
              <p style="margin: 0;">Every XeroLinux theme, rice and script in one app, on any Arch-based system.</p>
              <ul class="feats" style="font-size: .94em;">
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Desktop rices and layouts</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>8 GRUB themes</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>System scripts and tools</span></li>
              </ul>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="font-size: .8em;">Needs python-pyqt6, then run</div>
                <div class="cmd one" style="--n: 62;"><pre style="background: var(--glass); color: var(--text); border: 1px solid var(--line);">curl -fsSL https://xerolinux.xyz/script/xero-tool.py | python3</pre><button type="button" data-copy="curl -fsSL https://xerolinux.xyz/script/xero-tool.py | python3" aria-label="Copy command" title="Copy" style="border: 1px solid var(--line); background: transparent; color: var(--text);"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>
              </div>
            </div>
          </div>
          <div class="dtop" data-pane="3" data-title="~/tools/ibackup-restore" data-sub="iBackup/Restore" hidden style="gap: max(16px, 2cqw);">
            <div class="dcell">
              <img class="dshot" src="/media/ibr-demo.webp" alt="iBackup/Restore screenshot" loading="lazy" style="border: 1px solid var(--line);">
            </div>
            <div style="min-width: 0; display: flex; flex-direction: column; gap: max(10px, calc(1.4*var(--qh)));">
              <div class="kick" style="color: var(--accentL);">Apps</div>
              <h3 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2.1em; line-height: 1; color: var(--text);">iBackup/Restore</h3>
              <p style="margin: 0;">Back up and restore iPhone and iPad on Linux.</p>
              <ul class="feats" style="font-size: .94em;">
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Full and encrypted backups</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Browse photos and documents</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>iOS updates and recovery</span></li>
              </ul>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="font-size: .8em;">Needs usbmuxd, then run the AppImage</div>
                <div class="cmd one" style="--n: 22;"><pre style="background: var(--glass); color: var(--text); border: 1px solid var(--line);">sudo pacman -S usbmuxd</pre><button type="button" data-copy="sudo pacman -S usbmuxd" aria-label="Copy command" title="Copy" style="border: 1px solid var(--line); background: transparent; color: var(--text);"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>
              </div>
              <div data-btnrow style="display: flex; flex-wrap: wrap; gap: 10px;"><a href="https://github.com/xerolinux/xero-ibr/releases/latest" data-appimage="xerolinux/xero-ibr" data-arch="x86_64" target="_blank" rel="noopener noreferrer" style="min-height: 44px; display: inline-flex; align-items: center; white-space: nowrap; padding: 0 18px; border-radius: 10px; text-decoration: none; font-weight: 700; background: var(--accent); color: #ffffff;">Download AppImage</a><a href="https://github.com/xerolinux/xero-ibr/releases/latest" data-appimage="xerolinux/xero-ibr" data-arch="aarch64" target="_blank" rel="noopener noreferrer" title="AppImage for ARM64 (aarch64)" style="min-height: 44px; display: inline-flex; align-items: center; white-space: nowrap; padding: 0 14px; border-radius: 10px; text-decoration: none; border: 1px solid var(--line); color: var(--text);">ARM64</a><a href="https://github.com/xerolinux/xero-ibr" target="_blank" rel="noopener noreferrer" style="min-height: 44px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 0 16px; border-radius: 10px; text-decoration: none; border: 1px solid var(--line); color: var(--text);"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex: none;"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>GitHub</a></div>
            </div>
          </div>
          <div class="dtop" data-pane="4" data-title="~/tools/howdy-qt" data-sub="Howdy-Qt" hidden style="gap: max(16px, 2cqw);">
            <div class="dcell">
              <img class="dshot" src="/media/HowdyQt.webp" alt="Howdy-Qt screenshot" loading="lazy" style="border: 1px solid var(--line);">
            </div>
            <div style="min-width: 0; display: flex; flex-direction: column; gap: max(10px, calc(1.4*var(--qh)));">
              <div class="kick" style="color: var(--accentL);">Apps</div>
              <h3 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2.1em; line-height: 1; color: var(--text);">Howdy-Qt</h3>
              <p style="margin: 0;">Windows Hello style face login for Linux.</p>
              <ul class="feats" style="font-size: .94em;">
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Add and test face models</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>SDDM and lock screen support</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Per-service face auth</span></li>
              </ul>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="font-size: .8em;">Build and install</div>
                <div class="cmd one" style="--n: 52;"><pre style="background: var(--glass); color: var(--text); border: 1px solid var(--line);">git clone https://github.com/xerolinux/xero-howdy-qt
cd xero-howdy-qt/Packaging/ &amp;&amp; makepkg -si</pre><button type="button" data-copy="git clone https://github.com/xerolinux/xero-howdy-qt
cd xero-howdy-qt/Packaging/ &amp;&amp; makepkg -si" aria-label="Copy command" title="Copy" style="border: 1px solid var(--line); background: transparent; color: var(--text);"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>
              </div>
              <div data-btnrow style="display: flex; flex-wrap: wrap; gap: 10px;"><a href="https://github.com/xerolinux/xero-howdy-qt" target="_blank" rel="noopener noreferrer" style="min-height: 44px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 0 16px; border-radius: 10px; text-decoration: none; border: 1px solid var(--line); color: var(--text);"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex: none;"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>GitHub</a></div>
            </div>
          </div>
          <div class="dtop" data-pane="9" data-title="~/tools/xfprintd-gui" data-sub="Fingerprint GUI" hidden style="gap: max(16px, 2cqw);">
            <div class="dcell">
              <img class="dshot" src="/media/xfprintd-gui.webp" alt="XeroLinux Fingerprint GUI screenshot" loading="lazy" style="border: 1px solid var(--line);">
            </div>
            <div style="min-width: 0; display: flex; flex-direction: column; gap: max(10px, calc(1.4*var(--qh)));">
              <div class="kick" style="color: var(--accentL);">Security</div>
              <h3 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2.1em; line-height: 1; color: var(--text);">Fingerprint GUI</h3>
              <p style="margin: 0;">Enroll fingerprints and use them for login, sudo and system prompts.</p>
              <ul class="feats" style="font-size: .94em;">
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Live feedback while enrolling</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Fingerprint for sudo and terminal</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Polkit and graphical prompts</span></li>
              </ul>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="font-size: .8em;">On XeroLinux</div>
                <div class="cmd one" style="--n: 27;"><pre style="background: var(--glass); color: var(--text); border: 1px solid var(--line);">sudo pacman -S xfprintd-gui</pre><button type="button" data-copy="sudo pacman -S xfprintd-gui" aria-label="Copy command" title="Copy" style="border: 1px solid var(--line); background: transparent; color: var(--text);"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>
              </div>
              <div data-btnrow style="display: flex; flex-wrap: wrap; gap: 10px;"><a href="https://github.com/xerolinux/xfprintd-gui" target="_blank" rel="noopener noreferrer" style="min-height: 44px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 0 16px; border-radius: 10px; text-decoration: none; border: 1px solid var(--line); color: var(--text);"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex: none;"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>GitHub</a></div>
            </div>
          </div>
          <div class="dtop" data-pane="10" data-title="~/tools/xsb-gui" data-sub="Limine/SecureBoot Enabler" hidden style="gap: max(16px, 2cqw);">
            <div class="dcell">
              <img class="dshot" src="/media/xsb-gui.webp" alt="Limine/SecureBoot Enabler screenshot" loading="lazy" style="border: 1px solid var(--line);">
            </div>
            <div style="min-width: 0; display: flex; flex-direction: column; gap: max(10px, calc(1.4*var(--qh)));">
              <div class="kick" style="color: var(--accentL);">System · Boot</div>
              <h3 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2.1em; line-height: 1; color: var(--text);">Limine/SecureBoot</h3>
              <p style="margin: 0;">Move from GRUB to Limine and turn on Secure Boot in one guided wizard.</p>
              <ul class="feats" style="font-size: .94em;">
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>GRUB to Limine migration</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Secure Boot keys signed via sbctl</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Keeps dual-boot and LUKS setups</span></li>
              </ul>
              <div style="font-size: .84em; color: var(--yellow);">⚠ Replaces your bootloader. Back up first.</div>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="font-size: .8em;">On XeroLinux</div>
                <div class="cmd one" style="--n: 22;"><pre style="background: var(--glass); color: var(--text); border: 1px solid var(--line);">sudo pacman -S xsb-gui</pre><button type="button" data-copy="sudo pacman -S xsb-gui" aria-label="Copy command" title="Copy" style="border: 1px solid var(--line); background: transparent; color: var(--text);"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>
              </div>
              <div data-btnrow style="display: flex; flex-wrap: wrap; gap: 10px;"><a href="https://wiki.xerolinux.xyz/secure-boot/" target="_blank" rel="noopener noreferrer" style="min-height: 44px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 0 16px; border-radius: 10px; text-decoration: none; border: 1px solid var(--line); color: var(--text);"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex: none;"><path d="M4 19.5V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z"></path><path d="M8 7h8"></path><path d="M8 11h6"></path></svg>Documentation</a></div>
            </div>
          </div>
          <div class="dtop" data-pane="6" data-title="~/tools/wallpaper-browser" data-sub="Wallpaper Browser" hidden style="gap: max(16px, 2cqw);">
            <div class="dcell">
              <video class="dshot" src="/media/walls-demo.mp4" poster="/media/walls-still.webp" preload="none" muted loop playsinline aria-label="Wallpaper Browser demo video" style="border: 1px solid var(--line);"></video>
            </div>
            <div style="min-width: 0; display: flex; flex-direction: column; gap: max(10px, calc(1.4*var(--qh)));">
              <div class="kick" style="color: var(--accentL);">Look &amp; Feel</div>
              <h3 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2.1em; line-height: 1; color: var(--text);">Wallpaper Browser</h3>
              <p style="margin: 0;">Browse and download static and live wallpapers in one app.</p>
              <ul class="feats" style="font-size: .94em;">
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Six online sources</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Batch downloads</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Set wallpapers directly</span></li>
              </ul>
