                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>Browse photos and documents</span></li>
                <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>iOS updates and recovery</span></li>
              </ul>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="font-size: .8em;">Needs usbmuxd, then run the AppImage</div>
                <div class="cmd"><pre style="background: var(--glass); color: var(--text); border: 1px solid var(--line);">sudo pacman -S usbmuxd</pre><button type="button" data-copy="sudo pacman -S usbmuxd" aria-label="Copy command" style="border: 1px solid var(--line); background: transparent; color: var(--text);">Copy</button></div>
              </div>
              <div data-btnrow style="display: flex; flex-wrap: wrap; gap: 10px;"><a href="https://github.com/xerolinux/xero-ibr/releases/latest" target="_blank" rel="noopener noreferrer" style="min-height: 44px; display: inline-flex; align-items: center; white-space: nowrap; padding: 0 18px; border-radius: 10px; text-decoration: none; font-weight: 700; background: var(--accent); color: #ffffff;">Download AppImage</a><a href="https://github.com/xerolinux/xero-ibr" target="_blank" rel="noopener noreferrer" style="min-height: 44px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 0 16px; border-radius: 10px; text-decoration: none; border: 1px solid var(--line); color: var(--text);"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex: none;"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>GitHub</a></div>
