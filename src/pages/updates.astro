---
import Shell from '../layouts/Shell.astro';
import { ANNOUNCE_API, ANNOUNCE_CHANNEL } from '../config';
---

<Shell title="Updates" description="XeroLinux project updates, straight from DarkXero." current="/updates/" label="Updates" winTitle="~/updates" winSub="#project-updates">
  <div class="pane" style="padding: max(14px, calc(2.4*var(--qh))) max(18px, 2cqw); gap: max(12px, calc(1.8*var(--qh))); font-size: max(13px, calc(1.5*var(--qh))); color: var(--text2);">
    <div class="dlhead" style="flex: none;">
      <div>
        <div class="kick" style="color: var(--accentL);">// Straight from Discord</div>
        <h2 style="margin: 6px 0 0; font-family: 'Chakra Petch', sans-serif; font-size: 2em; line-height: 1; color: var(--text);">Project Updates</h2>
      </div>
      <div class="aside">
        <span class="alive" data-ann-status>connecting</span>
        <a href={ANNOUNCE_CHANNEL} target="_blank" rel="noopener noreferrer">#project-updates ↗</a>
      </div>
    </div>
    <div class="acut"><b>Live</b><span class="astrip"><canvas data-ann-bars aria-hidden="true"></canvas><span>Coming to you Live from Discord !<em> · every update, straight from DarkXero</em></span></span></div>
    <div class="afeed" data-ann={ANNOUNCE_API} aria-live="polite">
      <p class="aempty">Loading updates from #project-updates…</p>
    </div>
  </div>
</Shell>
