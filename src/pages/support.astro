---
import Shell from '../layouts/Shell.astro';
import { KOFI } from '../config';
import { SUPPORTERS } from '../data/kofi';

const goes = [
  ['Servers & bandwidth', 'The website, download hosting and every ISO you pull down.'],
  ['Real hardware', 'Testing every release on Intel, AMD and nVidia.'],
  ['Time', 'Building, fixing, packaging and answering questions on Discord.'],
];
const wallets = [
  { id: 'BTC', glyph: '₿', net: 'Bitcoin', addr: 'bc1qhl7qmeh8rlk35cggrr3py7j6670c4dnsh4veyl', qr: '/media/qr-btc.png' },
  { id: 'USDT', glyph: '₮', net: 'TRON (TRC-20)', addr: 'TLgG5Qh8XL1M98it9TSLRzoLDVCPwYQhYd', qr: '/media/qr-usdt.png' },
  { id: 'ETH', glyph: 'Ξ', net: 'Ethereum', addr: '0xEe53C2dcbf1AC11aC964f318b2759BcF70D6C0A0', qr: '/media/qr-eth.png' },
];
const kofiIcon = 'M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z';
---

<Shell title="Support" description="XeroLinux is funded by its community. Support it on Ko-fi or with crypto." current="/support/" label="Support" winTitle="~/support" winSub="thank you">
  <div class="pane" style="padding: max(14px, calc(2.4*var(--qh))) max(18px, 2cqw); gap: max(12px, calc(2*var(--qh))); font-size: max(13px, calc(1.5*var(--qh))); color: var(--text2);">
    <div class="dlhead" style="flex: none;">
      <div>
        <div class="kick" style="color: var(--accentL);">// Keep it alive</div>
        <h2 style="margin: 6px 0 0; font-family: 'Chakra Petch', sans-serif; font-size: 2em; line-height: 1; color: var(--text);">Support XeroLinux</h2>
      </div>
      <div class="sstats">
        <div><div class="big">0</div><div class="kick">ads</div></div>
        <div><div class="big" data-supporters={KOFI.proxy}>{SUPPORTERS.toLocaleString('en-US')}</div><div class="kick">supporters</div></div>
        <div><div class="big pprice">100%</div><div class="kick">community funded</div></div>
      </div>
    </div>

    <div class="supbody">
      <div class="spitch">
        <div style="display: flex; flex-direction: column; gap: max(10px, calc(1.4*var(--qh)));">
          <div class="slead">XeroLinux runs on you.</div>
          <p style="margin: 0;">There's no company, no investors and no ads behind XeroLinux. Every quarterly release, every download and every hour spent testing on real hardware is paid for by the people who use it. <strong style="color: var(--text);">Your support is how the bills get paid.</strong></p>
          <p style="margin: 0;"><span data-mode="free">XeroLinux is free to download, and it stays that way because of donations. </span>If it saves you time or makes your desktop nicer to live with, chipping in keeps it going. Any amount helps, and all of it goes back into the project.</p>
        </div>
        <div>
          <div class="kick" style="color: var(--accentL);">// Where it goes</div>
          <ul class="sgo">
            {goes.map(([t, d]) => <li><span aria-hidden="true">▸</span><span><b>{t}</b>{d}</span></li>)}
          </ul>
        </div>
      </div>

      <div class="kfm">
        <a class="kbadge" href={KOFI.link} target="_blank" rel="noopener noreferrer" aria-label="Support on Ko-fi">
          <svg class="kring" aria-hidden="true" viewBox="0 0 150 150"><defs><path id="kring-path" d="M75 75 m-60 0 a60 60 0 1 1 120 0 a60 60 0 1 1 -120 0"></path></defs><text><textPath href="#kring-path">SUPPORT XEROLINUX · BUY A COFFEE · </textPath></text></svg>
          <span class="kcup"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d={kofiIcon}></path></svg></span>
        </a>
        <div class="kfmtxt">
          <div class="kick" style="color: var(--accentL);">// Ko-fi</div>
          <div class="kfmh">Every coffee keeps <span class="khl">XeroLinux going.</span></div>
          <div class="kfms">Every euro goes into hosting, hardware and releases.</div>
        </div>
        <a href={KOFI.link} target="_blank" rel="noopener noreferrer" class="pri dlbtn kbtn">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d={kofiIcon}></path></svg>Support on Ko-fi<span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="crow" data-tabs>
        <div class="kick">// Prefer crypto?</div>
        <div class="chead">
          <div class="wsel" role="group" aria-label="Wallet">
            {wallets.map((w, i) => <button type="button" data-tab={String(i)} aria-pressed={i === 0 ? "true" : "false"}><span aria-hidden="true">{w.glyph}</span>{w.id}</button>)}
          </div>
          <div class="wdisc">Other wallet? <a href="https://discord.xerolinux.xyz" target="_blank" rel="noopener noreferrer" style="color: var(--accentL);">Ask on Discord</a>.</div>
        </div>
        {wallets.map((w, i) => (
          <div class="wpane" data-pane={String(i)} hidden={i !== 0}>
            <div class="wtext">
              <div class="wsend">Send only <strong style="color: var(--text);">{w.id}</strong> on the <strong style="color: var(--text);">{w.net}</strong> network.</div>
              <div class="wslogan">
                <span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 21h18M5 21V10M19 21V10M9 21v-7M15 21v-7M2 10l10-6 10 6"></path><path d="M3 3l18 18"></path></svg>No banks</span>
                <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"></circle><path d="M2 21a7 7 0 0 1 14 0M17 8l5 5M22 8l-5 5"></path></svg>No middlemen</span>
                <span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>Straight to XeroLinux</span>
              </div>
              <div class="waddr">
                <code class="addr">{w.addr}</code>
                <button type="button" data-copy={w.addr} aria-label={`Copy ${w.id} address`}>Copy</button>
              </div>
            </div>
            <img class="qr" src={w.qr} alt={`QR code for the ${w.id} address`} width="180" height="180" loading={i === 0 ? "eager" : "lazy"} decoding="async">
          </div>
        ))}
      </div>
    </div>
  </div>
</Shell>
