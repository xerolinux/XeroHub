---
import Shell from '../layouts/Shell.astro';
const now = new Date();
const age = now.getFullYear() - 1980 - (now < new Date(now.getFullYear(), 7, 12) ? 1 : 0);
---

<Shell title="About" description="About DarkXero, the creator and maintainer of XeroLinux." current="/about/" label="About" winTitle="~/about" winSub="whoami">
        <div class="pane" style="padding: max(14px, calc(2.4*var(--qh))) max(18px, 2cqw); font-size: max(13px, calc(1.5*var(--qh))); color: var(--text2);">
          <div class="ab2" style="gap: max(16px, 2cqw);">
            <aside class="abcard" style="gap: max(10px, calc(1.6*var(--qh))); padding: max(18px, calc(2.6*var(--qh))) max(16px, 1.6cqw); background: var(--soft); border: 1px solid var(--line);">
              <div class="avring" style="background: radial-gradient(circle, color-mix(in srgb, var(--accentL) 35%, transparent) 0%, color-mix(in srgb, var(--accent) 12%, transparent) 55%, transparent 70%); border: 2px solid var(--accentL);">
                <img src="/media/avatar.webp" alt="DarkXero avatar" style="width: 78%; height: 78%; object-fit: contain; display: block;">
              </div>
              <div>
                <div style="font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 2em; line-height: 1; color: var(--text);">Steve</div>
                <div class="kick" style="margin-top: 6px; color: var(--accentL);">TechXero · DarkXero</div>
              </div>
              <div style="font-size: .92em;">Creator and maintainer of XeroLinux</div>
              <div class="facts">
                <div class="fact" style="background: var(--glass);"><b style="color: var(--text);">{age}</b><span>years old</span></div>
                <div class="fact" style="background: var(--glass);"><b style="color: var(--text);">Lebanon</b><span>home</span></div>
                <div class="fact" style="background: var(--glass);"><b style="color: var(--text);">2019</b><span>on Linux since</span></div>
                <div class="fact" style="background: var(--glass);"><b style="color: var(--text);">2020</b><span>XeroLinux born</span></div>
              </div>
              <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                <div class="kick" style="font-size: .8em;">Multi-OS user</div>
                <div class="chips" style="justify-content: center;"><span class="chip" style="background: var(--glass);">iOS</span><span class="chip" style="background: var(--glass);">Android</span><span class="chip" style="background: var(--glass);">macOS</span><span class="chip" style="background: var(--glass);">Windows</span><span class="chip" style="background: var(--glass);">Linux</span></div>
              </div>
            </aside>
            <div style="min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: max(12px, calc(1.8*var(--qh)));">
              <div>
                <div class="kick" style="color: var(--accentL);">// The Profile</div>
                <h2 style="margin: 6px 0 0; font-family: 'Chakra Petch', sans-serif; font-size: 2.2em; line-height: 1.05; color: var(--text);">The man behind the distro</h2>
              </div>
              <p style="margin: 0; line-height: 1.65;">I love technology. I don't stick to one platform, I like to dabble in all of them.</p>
              <p style="margin: 0; line-height: 1.65;">I have been using <strong style="color: var(--text);">Gnu/Linux</strong> since 2019. In 2020 I decided to create <strong style="color: var(--text);">XeroLinux</strong> to satisfy my needs. After sharing it with some friends, they convinced me to make it public, and the rest is history as they say...</p>
              <p style="margin: 0; line-height: 1.65;">To know more about me, my likes/dislikes, and other juicy details, visit my <a href="https://techxero.com" target="_blank" rel="noopener noreferrer" style="color: var(--accentL);">Personal Site</a>. Enjoy your stay here.</p>
              <div style="font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 1.3em; color: var(--accentL);">Cheers y'all</div>
              <div style="height: 1px; background: var(--line);"></div>
              <div class="kick" style="color: var(--accentL);">// Find me online</div>
              <div class="soc" style="color: var(--text);">
                <a href="https://wiki.xerolinux.xyz" target="_blank" rel="noopener noreferrer" style="background: var(--soft); border: 1px solid var(--line);"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accentL);"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.680-.93 2.25z"></path></svg>Wiki</a>
                <a href="https://discord.gg/5sqxTSuKZu" target="_blank" rel="noopener noreferrer" style="background: var(--soft); border: 1px solid var(--line);"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accentL);"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"></path></svg>Discord</a>
                <a href="https://github.com/xerolinux" target="_blank" rel="noopener noreferrer" style="background: var(--soft); border: 1px solid var(--line);"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accentL);"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>GitHub</a>
                <a href="https://fosstodon.org/@XeroLinux" target="_blank" rel="noopener noreferrer" style="background: var(--soft); border: 1px solid var(--line);"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accentL);"><path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 00.023-.043v-1.809a.052.052 0 00-.02-.041.053.053 0 00-.046-.01 20.282 20.282 0 01-4.709.547c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 01-.319-1.433.053.053 0 01.066-.054 19.648 19.648 0 004.581.536h.344c1.705 0 3.42-.093 5.104-.37 1.974-.343 3.82-1.485 4.007-4.594.073-1.219.099-2.44.072-3.66.006-.472.1-3.025-.012-4.593zm-3.445 7.654h-2.56v-7.03c0-1.517-.648-2.278-1.885-2.278-1.413 0-2.12.907-2.12 2.707v3.826h-2.55V6.366c0-1.8-.707-2.707-2.12-2.707-1.236 0-1.884.761-1.884 2.278v7.030H4.146V5.862c0-1.517.39-2.723 1.17-3.618.805-.896 1.858-1.354 3.166-1.354 1.513 0 2.66.578 3.423 1.734L12.88 4.1l.975-1.476c.763-1.156 1.91-1.734 3.423-1.734 1.307 0 2.361.458 3.165 1.354.782.895 1.171 2.101 1.171 3.618v7.105z"></path></svg>Mastodon</a>
                <a href="https://youtube.com/@XeroLinux" target="_blank" rel="noopener noreferrer" style="background: var(--soft); border: 1px solid var(--line);"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accentL);"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.070 0 12 0 12s0 3.930.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.930 24 12 24 12s0-3.930-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg>YouTube</a>
                <a href="https://x.com/XeroLinuxOP" target="_blank" rel="noopener noreferrer" style="background: var(--soft); border: 1px solid var(--line);"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accentL);"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>Twitter/X</a>
                <a href="https://bytes.xerolinux.xyz" target="_blank" rel="noopener noreferrer" style="background: var(--soft); border: 1px solid var(--line);"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accentL);"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8l8 5 8-5v10zm-8-7L4 6h16l-8 5z"></path></svg>XeroBytes</a>
                <a href="https://linkedin.com/in/schaanine" target="_blank" rel="noopener noreferrer" style="background: var(--soft); border: 1px solid var(--line);"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" style="color: var(--accentL);"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.370 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.920-2.063 2.063-2.063 1.140 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.200 24 24 23.227 24 22.271V1.729C24 .774 23.200 0 22.222 0h.003z"></path></svg>LinkedIn</a>
