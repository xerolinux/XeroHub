---
import Shell from '../layouts/Shell.astro';
---

<Shell title="XeroLinux" description="XeroLinux: a configured KDE Plasma 6 desktop on top of Arch Linux, with a working installer, tuned kernels and in-house tools." current="/" label="Screenshots" winTitle="KDE Plasma 6" winSub="Themed panels, Wayland session, ready to use">
      <div class="shot" data-slides>
        <img class="fade on" data-slide="0" data-title="KDE Plasma 6" data-sub="Themed panels, Wayland session, ready to use" src="/media/Desktop.webp" alt="KDE Plasma 6 desktop" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">
        <img class="fade" data-slide="1" data-title="Calamares" data-sub="Keyboard, partitioning and desktop in a guided flow" src="/media/Calamares.webp" alt="Calamares installer" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">
        <img class="fade" data-slide="2" data-title="XeroLinux Toolkit" data-sub="Drivers, gaming stacks, themes and tweaks" src="/media/Toolkit.webp" alt="XeroLinux Toolkit" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">
      </div>
      <div class="thumbs" style="gap: max(8px, 1cqw); padding: max(10px, 1.4cqh);">
        <button type="button" class="tb" data-slide-btn="0" aria-pressed="true" aria-label="Show KDE Plasma 6" style="padding: 6px; border-radius: 12px; color: var(--text);">
          <img class="ti" src="/media/Desktop.webp" alt="" style="aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; display: block; flex: none;">
          <span style="font-size: max(13px, 1.45cqh); font-weight: 600;">KDE Plasma 6</span>
        </button>
        <button type="button" class="tb" data-slide-btn="1" aria-pressed="false" aria-label="Show Calamares" style="padding: 6px; border-radius: 12px; color: var(--text);">
          <img class="ti" src="/media/Calamares.webp" alt="" style="aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; display: block; flex: none;">
          <span style="font-size: max(13px, 1.45cqh); font-weight: 600;">Calamares</span>
        </button>
        <button type="button" class="tb" data-slide-btn="2" aria-pressed="false" aria-label="Show XeroLinux Toolkit" style="padding: 6px; border-radius: 12px; color: var(--text);">
          <img class="ti" src="/media/Toolkit.webp" alt="" style="aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; display: block; flex: none;">
          <span style="font-size: max(13px, 1.45cqh); font-weight: 600;">XeroLinux Toolkit</span>
        </button>
      </div>
</Shell>
