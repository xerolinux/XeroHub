---
import { KOFI_GOAL } from '../config';
import { GOAL } from '../data/kofi';

const eur = (n: number) => `€${n.toLocaleString('en-US')}`;
const pct = Math.min(100, Math.max(0, GOAL.pct));
---

<a class="kgoal" href={KOFI_GOAL.link} target="_blank" rel="noopener noreferrer" data-kgoal={KOFI_GOAL.proxy} aria-label={`Ko-fi goal: ${GOAL.title}, ${pct}% funded. Opens Ko-fi.`}>
  <span class="kghead">
    <span class="kick" style="color: var(--accentL);">// Support jar · Ko-fi</span>
    <span class="kgpct" data-kg="pct">{pct}%</span>
  </span>
  <span class="kgtrow"><svg class="kgico" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z"></path></svg><span class="kgtitle" data-kg="title">{GOAL.title}</span></span>
  <span class="kgbar" aria-hidden="true"><i data-kg="fill" style={`width: ${pct}%`}></i></span>
  <span class="kgfoot">
    <span><b data-kg="current">{eur(GOAL.currentEUR)}</b> / <span data-kg="target">{eur(GOAL.targetEUR)}</span></span>
    <span class="kgcta">Support <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></span>
  </span>
</a>
