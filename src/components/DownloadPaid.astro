---
import Changelog from './Changelog.astro';
import { ISO_PRICE_EUR, KOFI_ISO_URL, PAID_STATS_URL, SALE, salePriceEUR } from '../config';
import { EDITIONS, ISO_FEATURES } from '../data/editions';
import EditionCol from './EditionCol.astro';

const fmt = (n: number) => n.toLocaleString('en-US');
const allTime = EDITIONS.reduce((s, e) => s + e.total, 0);
const releaseTotal = EDITIONS.reduce((s, e) => s + e.release, 0);
const btn = 'min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; white-space: nowrap; padding: 0 10px; border-radius: 12px; text-decoration: none; font-weight: 600;';
---

<div class="pane" data-stats={PAID_STATS_URL || undefined} style="padding: max(14px, calc(2.4*var(--qh))) max(18px, 2cqw); gap: max(12px, calc(2*var(--qh))); font-size: max(13px, calc(1.5*var(--qh))); color: var(--text2);">
  <div class="dlhead" style="flex: none;">
    <div>
      <div class="kick" style="color: var(--accentL);">// Get XeroLinux · Quarterly</div>
      <div style="margin-top: 6px; display: flex; align-items: center; gap: 14px;"><h2 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2em; line-height: 1; color: var(--text);">Download</h2><Changelog /></div>
    </div>
    <div style="display: flex; gap: max(16px, 2cqw); align-items: flex-end;">
      <div style="text-align: right;">
        <div class="big" data-stat="allTime" style="font-size: 2.8em; color: var(--text);">{fmt(allTime)}</div>
        <div class="kick" style="margin-top: 6px;">downloads all-time</div>
      </div>
      <div style="text-align: right; padding-left: max(16px, 2cqw); border-left: 1px solid var(--line);">
        <div class="big" data-stat="releaseTotal" style="font-size: 2.8em; color: var(--accentL);">{fmt(releaseTotal)}</div>
        <div class="kick" style="margin-top: 6px;">this release</div>
      </div>
    </div>
  </div>

  <div class="dlbody" data-sale-window data-enabled={String(SALE.enabled)} data-start={SALE.start} data-end={SALE.end}>
    <div class="pedits">
      {EDITIONS.map((e) => (
        <div class="pedit" style={`--ea: ${e.a}; --eb: ${e.b};`}><EditionCol e={e} /></div>
      ))}
    </div>

    <div class="pbuy">
      <div style="flex: 1 1 340px; min-width: 0; display: flex; align-items: flex-end; gap: max(14px, 1.6cqw);">
        <div data-sale="off"><div class="big pprice" style="font-size: 2.8em;">€{ISO_PRICE_EUR}</div></div>
        <div data-sale="on" hidden><div class="big" style="font-size: 2.8em;"><s style="font-size: .5em; color: var(--text2); margin-right: 8px;">€{ISO_PRICE_EUR}</s><span class="pprice">€{salePriceEUR}</span></div></div>
        <div style="padding-bottom: 4px;">
          <div style="color: var(--text);">One-time · lifetime updates</div>
          <div data-sale="off" style="font-size: .9em;">Donate once and every quarterly release after that is yours.</div>
          <div data-sale="on" hidden style="font-size: .9em; color: var(--accentL);">Save {SALE.percent}% · {SALE.note}</div>
        </div>
      </div>
      <div data-btnrow style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end;">
        <a data-sale="off" href={KOFI_ISO_URL} target="_blank" rel="noopener noreferrer" class="pri" style={btn + ' padding: 0 22px; color: #ffffff;'}>Get it on Ko-fi</a>
        <a data-sale="on" hidden href={SALE.kofiUrl} target="_blank" rel="noopener noreferrer" class="pri" style={btn + ' padding: 0 22px; color: #ffffff;'}>{SALE.label} on Ko-fi</a>
        <a href="/support/" style={btn + ' padding: 0 16px; border: 1px solid var(--line); color: var(--text);'}>Pay with crypto</a>
        <a href="/access/" style={btn + ' padding: 0 16px; border: 1px solid var(--accentL); color: var(--text);'}>I have a code</a>
      </div>
    </div>

    <ul class="feats pfeats" style="font-size: .9em;">
      {ISO_FEATURES.map((f) => <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>{f}</span></li>)}
    </ul>
  </div>
</div>
