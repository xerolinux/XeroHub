---
import Changelog from './Changelog.astro';
import EditionCol from './EditionCol.astro';
import { DL_API } from '../config';
import { EDITIONS, ISO_FEATURES } from '../data/editions';

const fmt = (n: number) => n.toLocaleString('en-US');
const allTime = EDITIONS.reduce((s, e) => s + e.total, 0);
const releaseTotal = EDITIONS.reduce((s, e) => s + e.release, 0);
const btn = 'min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; white-space: nowrap; padding: 0 20px; border-radius: 12px; text-decoration: none; font-weight: 700;';
const ghost = 'min-height: 48px; padding: 0 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--glass); color: var(--text); font-weight: 600; font-size: .86em;';
---

<div class="pane" data-stats={`${DL_API}/stats`} style="padding: max(14px, calc(2.4*var(--qh))) max(18px, 2cqw); gap: max(12px, calc(2*var(--qh))); font-size: max(13px, calc(1.5*var(--qh))); color: var(--text2);">
  <div class="dlhead" style="flex: none;">
    <div>
      <div class="kick" style="color: var(--accentL);">// Get XeroLinux · Free · Quarterly</div>
      <div style="margin-top: 6px; display: flex; align-items: center; gap: 14px;"><h2 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2em; line-height: 1; color: var(--text);">Download</h2><Changelog /></div>
    </div>
    <div style="display: flex; gap: max(16px, 2cqw); align-items: flex-end;">
      <div style="text-align: right;">
        <div class="big" data-stat="allTime" style="font-size: 2.8em; color: var(--text);">{fmt(allTime)}</div>
        <div class="kick" style="margin-top: 6px;">downloads all-time</div>
      </div>
      <div style="text-align: right; padding-left: max(16px, 2cqw); border-left: 1px solid var(--line);">
        <div class="big" data-stat="releaseTotal" style="font-size: 2.8em; color: var(--accentL);">{fmt(releaseTotal)}</div>
        <div class="kick" style="margin-top: 6px;">this release</div>
      </div>
    </div>
  </div>

  <div class="dlbody">
    <div class="pedits">
      {EDITIONS.map((e) => (
        <div class="pedit ed" data-ed={e.id} style={`--ea: ${e.a}; --eb: ${e.b};`}>
          <EditionCol e={e} />
          <div data-btnrow class="edact">
              <a href={`${DL_API}/dl/${e.id}?dl=${e.file}`} data-dl={e.id} class="pri dlbtn" style={btn + ' flex: 1 1 auto; color: #ffffff;'}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>Download · {e.sizeGB}</a>
              <button type="button" data-pop-open aria-expanded="false" style={ghost}>Verify checksums</button>
            </div>
          <div role="dialog" aria-label={`${e.file} checksums`} data-pop hidden class="sumpop">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;">
              <div style="min-width: 0;">
                <div style="font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 1.25em; color: var(--text);">Verify checksums</div>
                <div style="font-family: 'JetBrains Mono', monospace; font-size: .86em; overflow-wrap: anywhere;">{e.file}</div>
              </div>
              <button type="button" data-pop-close aria-label="Close checksums" style="flex: none; min-width: 44px; min-height: 44px; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: var(--text); font-size: 1.2em;">✕</button>
            </div>
            {([['SHA256', e.sha256], ['SHA1', e.sha1], ['MD5', e.md5]] as const).map(([label, hash]) => (
              <div class="hrow" style="padding: 10px 12px; border-radius: 12px; background: var(--soft);">
                <div style="flex: 1; min-width: 0;"><div class="kick" style="font-size: .86em; color: var(--accentL);">{label}</div><div class="hash" style="color: var(--text);">{hash}</div></div>
                <button type="button" data-copy={hash} aria-label={`Copy ${label}`} style="border: 1px solid var(--line); background: transparent; color: var(--text);">Copy</button>
              </div>
            ))}
            <div style="margin-top: auto; font-size: .88em;">Check after downloading: <code style="font-family: 'JetBrains Mono', monospace; font-size: .95em; padding: 2px 6px; border-radius: 5px; background: var(--soft); color: var(--text); overflow-wrap: anywhere;">sha256sum {e.file}</code></div>
          </div>
        </div>
      ))}
    </div>

    <div class="pbuy">
      <div style="flex: 1 1 300px; min-width: 0; display: flex; align-items: flex-end; gap: max(14px, 1.6cqw);">
        <div class="big pprice" style="font-size: 2.8em;">Free</div>
        <div style="padding-bottom: 4px;">
          <div style="color: var(--text);">No cost · quarterly releases</div>
          <div style="font-size: .92em;">Downloads limited to 5 per visitor.</div>
        </div>
      </div>
      <p style="flex: 1 1 280px; max-width: 460px; margin: 0; font-size: .92em;">Not sure which one? Pick <strong style="color: var(--text);">nVidia</strong> only if your machine has an nVidia GPU, otherwise grab <strong style="color: var(--text);">Intel / AMD</strong>.</p>
    </div>

    <ul class="feats pfeats" style="font-size: .9em;">
      {ISO_FEATURES.map((f) => <li style="display: flex; gap: 8px;"><span style="color: var(--accentL);">▸</span><span>{f}</span></li>)}
    </ul>
  </div>
</div>
