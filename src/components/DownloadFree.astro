---
import Changelog from './Changelog.astro';
import { DL_API } from '../config';
---

        <div class="pane" data-stats={`${DL_API}/stats`} style="padding: max(14px, 2.4cqh) max(18px, 2cqw); gap: max(12px, 2cqh); font-size: max(13px, 1.5cqh); color: var(--text2);">
          <div class="dlhead" style="flex: none;">
            <div>
              <div class="kick" style="color: var(--accentL);">// Get XeroLinux · Free · Quarterly</div>
              <div style="margin-top: 6px; display: flex; align-items: center; gap: 14px;"><h2 style="margin: 0; font-family: 'Chakra Petch', sans-serif; font-size: 2em; line-height: 1; color: var(--text);">Download</h2><Changelog /></div>
            </div>
            <div style="display: flex; gap: max(16px, 2cqw); align-items: flex-end;">
              <div style="text-align: right;">
                <div class="big" data-stat="allTime" style="font-size: 2.8em; color: var(--text);">1,996</div>
                <div class="kick" style="margin-top: 6px;">downloads all-time</div>
              </div>
              <div style="text-align: right; padding-left: max(16px, 2cqw); border-left: 1px solid var(--line);">
                <div class="big" data-stat="releaseTotal" style="font-size: 2.8em; color: var(--accentL);">327</div>
                <div class="kick" style="margin-top: 6px;">this release</div>
              </div>
            </div>
          </div>
          <div class="dlg" style="gap: max(12px, 1.4cqw);">
            <article class="ed" data-ed="std" style="position: relative; gap: max(10px, 1.5cqh); padding: max(16px, 2.2cqh); border-radius: 18px; background: var(--soft); border: 1px solid var(--line);">
              <div style="display: flex; gap: max(14px, 1.6cqw); align-items: center;">
                <div class="disc" aria-hidden="true" style="background: radial-gradient(circle, var(--bg) 0 14%, rgba(255,255,255,0.55) 14.5% 16.5%, rgba(10,12,28,0.35) 17% 30%, transparent 30.5%), conic-gradient(from 0deg, rgb(66,133,244), rgba(66,133,244,0.55) 12%, #fff 18%, rgba(66,133,244,0.7) 25%, rgb(238,57,57) 42%, rgba(238,57,57,0.6) 55%, #fff 62%, rgba(238,57,57,0.75) 70%, rgb(66,133,244) 88%, rgb(66,133,244)); box-shadow: 0 0 30px rgba(66,133,244,0.45), 0 0 54px rgba(238,57,57,0.2), inset 0 0 0 1px rgba(255,255,255,0.35);"></div>
                <div style="min-width: 0; display: flex; flex-direction: column; gap: 5px;">
                  <div style="font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 1.45em; color: var(--text);"><span style="color: #4285f4;">Intel</span><span style="color: var(--text2);"> / </span><span style="color: #ee3939;">AMD</span></div>
                  <div style="font-size: .86em;">For systems with an Intel or AMD GPU/iGPU</div>
                  <div class="kick" style="margin-top: 6px; color: var(--accentL);">Latest release · <span data-stat="std.version">2026.09</span></div>
                  <div data-stat="std.file" style="font-family: 'JetBrains Mono', monospace; font-size: .82em; color: var(--text); word-break: break-all;">xerolinux-2026.09-x86_64.iso</div>
                </div>
              </div>
              <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; padding: max(10px, 1.4cqh) 16px; border-radius: 14px; background: var(--glass); border: 1px solid var(--line);">
                <div>
                  <div class="big" data-stat="std.release" style="font-size: 2.6em; color: var(--text);">171</div>
                  <div class="kick" style="margin-top: 6px;">downloads this release</div>
                </div>
                <div style="text-align: right;">
                  <div class="big" data-stat="std.total" style="font-size: 1.4em; color: var(--accentL);">1,044</div>
                  <div class="kick" style="margin-top: 4px; font-size: .68em;">all-time</div>
                </div>
              </div>
              <div class="chips"><span class="chip" style="background: var(--glass);">Sep 2, 2026</span><span class="chip" style="background: var(--glass);">x86_64</span><span class="chip" style="background: var(--glass);">5.7 GB</span><span class="chip" style="background: var(--glass);">ISO</span></div>
              <div data-btnrow style="margin-top: max(8px, 1.5cqh); display: flex; gap: 10px; flex-wrap: wrap;">
                <a href={`${DL_API}/dl/std?dl=xerolinux-2026.09-x86_64.iso`} data-dl="std" style="flex: 1 1 auto; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border-radius: 12px; text-decoration: none; font-weight: 700; font-size: 1.05em; background: var(--accent); color: #ffffff;"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>Download · 5.7 GB</a>
                <button type="button" data-pop-open aria-expanded="false" style="flex: 0 1 auto; min-height: 48px; padding: 0 16px; border-radius: 12px; border: 1px solid var(--line); background: transparent; color: var(--text); font-weight: 600;">Verify checksums</button>
              </div>
              <div role="dialog" aria-label="xerolinux-2026.09-x86_64.iso checksums" data-pop hidden style="position: absolute; inset: 0; z-index: 2; box-sizing: border-box; display: flex; flex-direction: column; gap: max(8px, 1.3cqh); padding: max(16px, 2.2cqh); border-radius: 18px; overflow-y: auto; background: var(--glassSolid); border: 1px solid var(--accentL); backdrop-filter: var(--blur); -webkit-backdrop-filter: var(--blur);">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;">
                  <div style="min-width: 0;">
                    <div style="font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 1.25em; color: var(--text);">Verify checksums</div>
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: .76em; word-break: break-all;">xerolinux-2026.09-x86_64.iso</div>
                  </div>
                  <button type="button" data-pop-close aria-label="Close checksums" style="flex: none; min-width: 44px; min-height: 44px; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: var(--text); font-size: 1.2em;">✕</button>
                </div>
                    <div class="hrow" style="padding: 10px 12px; border-radius: 12px; background: var(--soft);">
                      <div style="flex: 1; min-width: 0;"><div class="kick" style="font-size: .66em; color: var(--accentL);">SHA256</div><div class="hash" style="color: var(--text);">a78a468bf960bf656751d42ce1e7d0a2880b567c5c638a89301a4917effdf8d6</div></div>
                      <button type="button" data-copy="a78a468bf960bf656751d42ce1e7d0a2880b567c5c638a89301a4917effdf8d6" aria-label="Copy SHA256" style="border: 1px solid var(--line); background: transparent; color: var(--text);">Copy</button>
                    </div>
                    <div class="hrow" style="padding: 10px 12px; border-radius: 12px; background: var(--soft);">
                      <div style="flex: 1; min-width: 0;"><div class="kick" style="font-size: .66em; color: var(--accentL);">SHA1</div><div class="hash" style="color: var(--text);">6294044b253bfdad32708e8114ace024d87aabff</div></div>
                      <button type="button" data-copy="6294044b253bfdad32708e8114ace024d87aabff" aria-label="Copy SHA1" style="border: 1px solid var(--line); background: transparent; color: var(--text);">Copy</button>
                    </div>
                    <div class="hrow" style="padding: 10px 12px; border-radius: 12px; background: var(--soft);">
                      <div style="flex: 1; min-width: 0;"><div class="kick" style="font-size: .66em; color: var(--accentL);">MD5</div><div class="hash" style="color: var(--text);">9ea937dbe275d7b932fc43be3f2d5b15</div></div>
                      <button type="button" data-copy="9ea937dbe275d7b932fc43be3f2d5b15" aria-label="Copy MD5" style="border: 1px solid var(--line); background: transparent; color: var(--text);">Copy</button>
                    </div>
                <div style="margin-top: auto; font-size: .8em;">Check after downloading: <code style="font-family: 'JetBrains Mono', monospace; font-size: .95em; padding: 2px 6px; border-radius: 5px; background: var(--soft); color: var(--text); word-break: break-all;">sha256sum xerolinux-2026.09-x86_64.iso</code></div>
              </div>
            </article>
            <article class="ed" data-ed="nvidia" style="position: relative; gap: max(10px, 1.5cqh); padding: max(16px, 2.2cqh); border-radius: 18px; background: var(--soft); border: 1px solid var(--line);">
              <div style="display: flex; gap: max(14px, 1.6cqw); align-items: center;">
                <div class="disc" aria-hidden="true" style="background: radial-gradient(circle, var(--bg) 0 14%, rgba(255,255,255,0.55) 14.5% 16.5%, rgba(10,12,28,0.35) 17% 30%, transparent 30.5%), conic-gradient(from 0deg, rgb(43,208,90), rgba(43,208,90,0.55) 12%, #fff 18%, rgba(43,208,90,0.7) 25%, rgb(86,87,245) 42%, rgba(86,87,245,0.6) 55%, #fff 62%, rgba(86,87,245,0.75) 70%, rgb(43,208,90) 88%, rgb(43,208,90)); box-shadow: 0 0 30px rgba(43,208,90,0.45), 0 0 54px rgba(86,87,245,0.2), inset 0 0 0 1px rgba(255,255,255,0.35);"></div>
                <div style="min-width: 0; display: flex; flex-direction: column; gap: 5px;">
                  <div style="font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 1.45em; color: var(--text);"><span style="color: #2bd05a;">nVidia</span><span style="color: var(--text2);"></span><span style="color: #2bd05a;"></span></div>
                  <div style="font-size: .86em;">For systems with an nVidia GPU</div>
                  <div class="kick" style="margin-top: 6px; color: var(--accentL);">Latest release · <span data-stat="nvidia.version">2026.09</span></div>
                  <div data-stat="nvidia.file" style="font-family: 'JetBrains Mono', monospace; font-size: .82em; color: var(--text); word-break: break-all;">xerolinux-nvidia-2026.09-x86_64.iso</div>
                </div>
              </div>
              <div style="display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; padding: max(10px, 1.4cqh) 16px; border-radius: 14px; background: var(--glass); border: 1px solid var(--line);">
                <div>
                  <div class="big" data-stat="nvidia.release" style="font-size: 2.6em; color: var(--text);">156</div>
                  <div class="kick" style="margin-top: 6px;">downloads this release</div>
                </div>
                <div style="text-align: right;">
                  <div class="big" data-stat="nvidia.total" style="font-size: 1.4em; color: var(--accentL);">952</div>
                  <div class="kick" style="margin-top: 4px; font-size: .68em;">all-time</div>
                </div>
              </div>
              <div class="chips"><span class="chip" style="background: var(--glass);">Sep 2, 2026</span><span class="chip" style="background: var(--glass);">x86_64</span><span class="chip" style="background: var(--glass);">7.1 GB</span><span class="chip" style="background: var(--glass);">ISO</span></div>
              <div data-btnrow style="margin-top: max(8px, 1.5cqh); display: flex; gap: 10px; flex-wrap: wrap;">
                <a href={`${DL_API}/dl/nvidia?dl=xerolinux-nvidia-2026.09-x86_64.iso`} data-dl="nvidia" style="flex: 1 1 auto; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border-radius: 12px; text-decoration: none; font-weight: 700; font-size: 1.05em; background: var(--accent); color: #ffffff;"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg>Download · 7.1 GB</a>
                <button type="button" data-pop-open aria-expanded="false" style="flex: 0 1 auto; min-height: 48px; padding: 0 16px; border-radius: 12px; border: 1px solid var(--line); background: transparent; color: var(--text); font-weight: 600;">Verify checksums</button>
              </div>
              <div role="dialog" aria-label="xerolinux-nvidia-2026.09-x86_64.iso checksums" data-pop hidden style="position: absolute; inset: 0; z-index: 2; box-sizing: border-box; display: flex; flex-direction: column; gap: max(8px, 1.3cqh); padding: max(16px, 2.2cqh); border-radius: 18px; overflow-y: auto; background: var(--glassSolid); border: 1px solid var(--accentL); backdrop-filter: var(--blur); -webkit-backdrop-filter: var(--blur);">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;">
                  <div style="min-width: 0;">
                    <div style="font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 1.25em; color: var(--text);">Verify checksums</div>
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: .76em; word-break: break-all;">xerolinux-nvidia-2026.09-x86_64.iso</div>
                  </div>
                  <button type="button" data-pop-close aria-label="Close checksums" style="flex: none; min-width: 44px; min-height: 44px; border-radius: 10px; border: 1px solid var(--line); background: transparent; color: var(--text); font-size: 1.2em;">✕</button>
                </div>
                    <div class="hrow" style="padding: 10px 12px; border-radius: 12px; background: var(--soft);">
                      <div style="flex: 1; min-width: 0;"><div class="kick" style="font-size: .66em; color: var(--accentL);">SHA256</div><div class="hash" style="color: var(--text);">df0397bd601a0f8f8835ff6671fb8c843c663e238cd9cb4a791027a86a640797</div></div>
                      <button type="button" data-copy="df0397bd601a0f8f8835ff6671fb8c843c663e238cd9cb4a791027a86a640797" aria-label="Copy SHA256" style="border: 1px solid var(--line); background: transparent; color: var(--text);">Copy</button>
                    </div>
                    <div class="hrow" style="padding: 10px 12px; border-radius: 12px; background: var(--soft);">
                      <div style="flex: 1; min-width: 0;"><div class="kick" style="font-size: .66em; color: var(--accentL);">SHA1</div><div class="hash" style="color: var(--text);">87d2219d089ee0a607003abe2b520145cf6239d6</div></div>
                      <button type="button" data-copy="87d2219d089ee0a607003abe2b520145cf6239d6" aria-label="Copy SHA1" style="border: 1px solid var(--line); background: transparent; color: var(--text);">Copy</button>
                    </div>
                    <div class="hrow" style="padding: 10px 12px; border-radius: 12px; background: var(--soft);">
                      <div style="flex: 1; min-width: 0;"><div class="kick" style="font-size: .66em; color: var(--accentL);">MD5</div><div class="hash" style="color: var(--text);">2e4eeee16c8fb81c37d62c4badf75ee2</div></div>
                      <button type="button" data-copy="2e4eeee16c8fb81c37d62c4badf75ee2" aria-label="Copy MD5" style="border: 1px solid var(--line); background: transparent; color: var(--text);">Copy</button>
                    </div>
                <div style="margin-top: auto; font-size: .8em;">Check after downloading: <code style="font-family: 'JetBrains Mono', monospace; font-size: .95em; padding: 2px 6px; border-radius: 5px; background: var(--soft); color: var(--text); word-break: break-all;">sha256sum xerolinux-nvidia-2026.09-x86_64.iso</code></div>
